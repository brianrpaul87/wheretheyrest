Options -Indexes
DirectoryIndex index.html

# Do not let LiteSpeed page caching hide newly published Where They Rest pages.
# Image/static asset browser caching below remains intact.
<IfModule LiteSpeed>
  CacheDisable public /
  CacheDisable private /
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Private/runtime folders and leftover duplicate site copies must not be web-accessible.
  RewriteRule ^(?:config|tests|vendor|wheretheyrest)(?:/|$) - [F,L,NC]
</IfModule>

# Block deployment archives, backups, logs, and internal instructions left in the document root.
<FilesMatch "(?i)(?:\.zip$|\.bak$|error_log$|^index Backup|^INSTALL-|^MAIL-DIAGNOSTIC|^OVERLAY-|^PATH-HOTFIX|^PACKAGE-SHA256SUMS|^README\.(?:md|txt)$|^\.gitignore$|^composer\.(?:json|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTML/policy/sitemap changes should be revalidated rather than served stale.
  <FilesMatch "\.(?:html|xml)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
